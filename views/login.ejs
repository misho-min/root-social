<!DOCTYPE html>
<html>
    <head>
        <title>Login</title>
        <link rel="stylesheet" type="text/css" href="css/styles.css" />
        <style>
            .formElement {
                margin-bottom:1%;
            }
        </style>
    </head>

    <body>
        <h1>Welcome back!</h1>

        <!-- Form to collect login info. On submission, this information will be passed into index.js and validated against the existing password to allow for login. Whatever is used for the "name" attribute is what will also be used when parsing the data in index.js. -->
        <form action="/welcome" method="post">
            <div class="formElement">
                <label for="username">Username: </label>
                <input class = "texBox" type="text" name="username" id="username">
            </div>

            <div class="formElement">
                <label for="password">Password: </label>
                <input class = "texBox" type="password" name="password" id="password">
            </div>

            <input class = "button" type="submit" name="submit" id="submit" value="Submit">

        </form>
    </body>

</html>