<!DOCTYPE html>
<html>
    <head>
        <title>Basic Login: Register</title>
        <link rel="stylesheet" type="text/css" href="css/styles.css" />
        <style>
            .formElement {
                margin-bottom:1%;
            }
        </style>
    </head>

    <body>
        <h1>Register for this site.</h1>

        <!-- Form to collect registration info. On submission, this information will be passed into index.js and saved into the database. Whatever is used for the "name" attribute is what will also be used when parsing the data in index.js. -->
        <form action="/welcome" method="post">
            <div class="formElement">
                <label for="username">Username: </label>
                <input type="text" name="username" id="username">
            </div>

            <div class="formElement">
                <label for="password">Password: </label>
                <input type="password" name="password" id="password">
            </div>

            <div class="formElement">
                <label for="name">Name: </label>
                <input type="text" name="name" id="name">
            </div>

            <div class="formElement">
                <label for="birthday">Date of birth: </label>
                <input type="date" name="birthday" id="birthday">
            </div>

            <input type="submit" name="submit" id="submit" value="Submit">

        </form>
    </body>

</html>