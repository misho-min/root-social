<!DOCTYPE html>
<html>
    <head>
        <title>Sign Up</title>
        <link rel="stylesheet" type="text/css" href="css/styles.css" />
        <style>
            .formElement {
                margin-bottom:1%;
            }
        </style>
    </head>

    <body>
        <h1>Sign Up For Root</h1>

        <!-- Form to collect registration info. On submission, this information will be passed into index.js and saved into the database. Whatever is used for the "name" attribute is what will also be used when parsing the data in index.js. -->
        <form class="formTextBoxes" action="/welcome" method="post">
            <div class="formElement">
                <label for="username">Username: </label>
                <input class = "texBox" type="text" name="username" id="username">
            </div>

            <div class="formElement">
                <label for="password">Password: </label>
                <input class = "texBox" type="password" name="password" id="password">
            </div>

            <div class="formElement">
                <label for="name">Name: </label>
                <input class = "texBox" type="text" name="name" id="name">
            </div>

            <div class="formElement">
                <label for="birthday">Date of birth: </label>
                <input class = "texBox" type="date" name="birthday" id="birthday">
            </div>

            <input class = "button" type="submit" name="submit" id="submit" value="Submit">

        </form>
    </body>

</html>